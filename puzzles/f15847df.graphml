    </node>
    <node id="n4">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[0, 2]]</data>
    </node>
    <node id="n5">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[1, 2]]</data>
    </node>
    <node id="n6">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[0, 3]]</data>
    </node>
    <node id="n7">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[1, 3]]</data>
    </node>
    <node id="n8">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[2, 3]]</data>
    </node>
    <node id="n9">
      <data key="key0">1</data>
      <data key="key1">0</data>
      <data key="key3">[[2, 2]]</data>
    </node>
    <node id="n10">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[3, 3]]</data>
    </node>
    <node id="n11">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[3, 2]]</data>
    </node>
    <node id="n12">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[3, 1]]</data>
    </node>
    <node id="n13">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[3, 0]]</data>
    </node>
    <node id="n14">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[2, 1]]</data>
    </node>
    <node id="n15">
      <data key="key0">0</data>
      <data key="key1">0</data>
      <data key="key3">[[2, 0]]</data>
    </node>

   <!-- edges -->
    <edge id="e0" source="n0" target="n1">
    </edge>
    <edge id="e1" source="n0" target="n2">
    </edge>
    <edge id="e2" source="n1" target="n15">
    </edge>
    <edge id="e3" source="n1" target="n3">
    </edge>
    <edge id="e4" source="n2" target="n3">
    </edge>
    <edge id="e5" source="n2" target="n4">
    </edge>
    <edge id="e6" source="n3" target="n14">
    </edge>
    <edge id="e7" source="n3" target="n5">
    </edge>
    <edge id="e8" source="n4" target="n5">
    </edge>
    <edge id="e9" source="n4" target="n6">
    </edge>
    <edge id="e10" source="n5" target="n9">
    </edge>
    <edge id="e11" source="n5" target="n7">
    </edge>
    <edge id="e12" source="n6" target="n7">
